# Supabase Dashboard から取得した値を設定してください。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 本番公開時に固定URLを使う場合のみ設定してください。
# ローカル/ネットワーク開発の認証確認メールは、実際に開いている origin をコード側で使用します。
# NEXT_PUBLIC_SITE_URL=https://example.com

# 購入確定・ポイント付与をNext.jsサーバーから安全に実行するために必要です。
# Supabase Dashboard > Project Settings > API から取得します。
# 絶対に NEXT_PUBLIC_ を付けず、ブラウザ側へ公開しないでください。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 開発時に別origin（リバースプロキシ等）からアクセスする場合のみ指定。
# 通常のlocalhost/LANアクセスでは不要です。カンマ区切りで複数指定できます。
# MACHINOWA_ALLOWED_DEV_ORIGINS=dev.example.local,*.example.local

# ⑤-6: 外部AI提案（任意）。未設定なら常に無料のルールベースへフォールバックします。
# Google AI Studio で取得したAPIキーをサーバー側だけに設定してください。
# NEXT_PUBLIC_ を付けるとブラウザへ漏れるため絶対に付けないでください。
# GEMINI_API_KEY=your-gemini-api-key

# 新規プロジェクト向けの低コスト/無料枠モデル。必要な場合だけ変更してください。
# MACHINOWA_GEMINI_MODEL=gemini-3.1-flash-lite

# 1端末（IP目安）あたりのAI提案回数。無料枠保護用。既定10回/分。
# MACHINOWA_AI_RATE_LIMIT_PER_MINUTE=10
