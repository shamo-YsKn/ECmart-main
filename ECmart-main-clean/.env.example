# Supabase Dashboard から取得した値を設定してください。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 本番公開時に固定URLを使う場合のみ設定してください。
# ローカル/ネットワーク開発の認証確認メールは、実際に開いている origin をコード側で使用します。
# NEXT_PUBLIC_SITE_URL=https://example.com

# 購入確定・ポイント付与をNext.jsサーバーから安全に実行するために必要です。
# Supabase Dashboard > Project Settings > API から取得します。
# 絶対に NEXT_PUBLIC_ を付けず、ブラウザ側へ公開しないでください。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
